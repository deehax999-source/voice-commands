#!/usr/bin/python3 -I
"""Fenster mit den letzten Antworten von Voice Commands: Text markieren oder per Knopf kopieren."""
import fcntl
import json
import os
import re
import shutil
import subprocess
import sys
from pathlib import Path

# Started from a terminal, Hyprland's window swallowing would hide the terminal. It finds the terminal
# through the parent processes, so the window continues in a grandchild that the system adopts. This
# happens before GTK is loaded, because forking after GTK has started threads can hang.
if os.environ.get("VOICE_COMMANDS_NO_DETACH") != "1":
    try:
        if os.fork() != 0:
            os._exit(0)
        os.setsid()
        if os.fork() != 0:
            os._exit(0)
    except OSError:
        pass

import gi
import importlib.util
from importlib.machinery import SourceFileLoader

gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
from gi.repository import Adw, Gdk, Gio, GLib, Gtk, Pango  # noqa: E402

# Markdown support lives next to this script, also when installed in /usr/bin
BIN = Path(os.path.realpath(__file__)).parent
sys.dont_write_bytecode = True
_loader = SourceFileLoader("voice_commands_markdown", str(BIN / "voice-commands-markdown"))
_spec = importlib.util.spec_from_loader(_loader.name, _loader)
MARKDOWN = importlib.util.module_from_spec(_spec)
_loader.exec_module(MARKDOWN)
_loader = SourceFileLoader("voice_commands_theme", str(BIN / "voice-commands-theme"))
_spec = importlib.util.spec_from_loader(_loader.name, _loader)
THEME = importlib.util.module_from_spec(_spec)
_loader.exec_module(THEME)
_loader = SourceFileLoader("voice_commands_commands", str(BIN / "voice-commands-commands"))
COMMANDS = importlib.util.module_from_spec(importlib.util.spec_from_loader(_loader.name, _loader))
_loader.exec_module(COMMANDS)
WORK = Path.home() / "Voice-Commands"
# The history, outside the working folder so that Claude and background programs cannot change it unasked
HISTORY = Path.home() / ".local/share/voice-commands/antworten.jsonl"
OLD_HISTORY = WORK / "antworten.jsonl"
CONFIG_HOME = Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config")
MODEL_FILE = CONFIG_HOME / "voice-commands" / "model"
SETTINGS_FILE = CONFIG_HOME / "voice-commands" / "settings.json"
HISTORY_LOCK = Path(os.environ.get("XDG_RUNTIME_DIR") or "/tmp") / "voice-commands" / "history.lock"
SPEAK_PID = Path(os.environ.get("XDG_RUNTIME_DIR") or "/tmp") / "voice-commands" / "speak.pid"
# voice-commands keeps the same number of entries in the history file
MAX_ENTRIES = 50
# The first choice uses whatever is the default in Claude Code
MODELS = ["", "haiku", "sonnet", "opus"]


