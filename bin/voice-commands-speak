#!/usr/bin/env bash
# Reads text aloud. Uses Piper with a more natural voice if it is installed, otherwise the system voice
# from speech-dispatcher or espeak-ng.
#   voice-commands-speak [slow|normal|fast]   reads the text on stdin, stopping anything still being read
#   voice-commands-speak stop                 stops reading; exit code 0 if something was being read
#   voice-commands-speak engine               prints piper, system or none
#   voice-commands-speak piper                prints the Piper program; exit code 1 if there is none
set -u

RUN="${XDG_RUNTIME_DIR:-/tmp}/voice-commands"
VOICES="$HOME/.local/share/voice-commands/voices"
PID_FILE="$RUN/speak.pid"
SPEAK_DIR=""
mkdir -p "$RUN"

stop() {
    local pid
    pid="$(cat "$PID_FILE" 2>/dev/null)" || return 1
    rm -f "$PID_FILE"
    [[ "$pid" =~ ^[0-9]+$ ]] && kill -0 "$pid" 2>/dev/null || return 1
    # The reader runs in its own process group, so this also ends the player
    kill -TERM -- "-$pid" 2>/dev/null || kill -TERM "$pid" 2>/dev/null
    command -v spd-say >/dev/null && spd-say --cancel >/dev/null 2>&1
    return 0
}

# speech-dispatcher can be installed without any voice, then it would wait forever
system_voice() {
    if command -v spd-say >/dev/null && [ -n "$(timeout 5 spd-say -O 2>/dev/null | tail -n +2 | tr -d '[:space:]')" ]; then
        echo spd-say
    elif command -v espeak-ng >/dev/null; then
        echo espeak-ng
    else
        return 1
    fi
}

# The AUR package piper-tts installs "piper-tts". "pipx install piper-tts" installs "piper" in
# ~/.local/bin, which is often not in PATH when a shortcut starts Voice Commands. Older packages call
# it "piper" too, which is also the name of an unrelated program for gaming mice, so a "piper" must
# show Piper's options. Sets PIPER and PIPER_HELP, so that reading asks Piper for its options only once.
PIPER="" PIPER_HELP=""
find_piper() {
    local candidate
    [ -z "$PIPER" ] || return 0
    for candidate in "$(command -v piper-tts)" "$(command -v piper)" "$HOME/.local/bin/piper"; do
        [ -n "$candidate" ] && [ -x "$candidate" ] || continue
        PIPER_HELP="$(timeout 10 "$candidate" --help 2>&1)"
        if [[ "$candidate" == */piper-tts || "$PIPER_HELP" == *--model* ]]; then
            PIPER="$candidate"
            return 0
        fi
    done
    return 1
}

piper_voice() { [ -s "$VOICES/$1.onnx" ] && [ -s "$VOICES/$1.onnx.json" ] && echo "$VOICES/$1.onnx"; }

engine() {
    if find_piper && { piper_voice de >/dev/null || piper_voice en >/dev/null; }; then
        echo piper
    elif system_voice >/dev/null; then
        echo system
    else
        echo none
    fi
}

# Claude replies in the language of the command, so the voice follows the text, not the system
language_of() {
    local words de en
    words=" $(printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | tr -cs '[:alpha:]äöüß' ' ') "
    de="$(grep -oE ' (der|die|das|und|ist|nicht|ich|du|ein|eine|mit|für|auf|den|dem|wird|habe|kann|sind) ' <<<"$words" | wc -l)"
    en="$(grep -oE ' (the|and|is|not|you|a|an|with|for|on|of|to|was|have|can|are|it|this) ' <<<"$words" | wc -l)"
    if [ "$de" -gt "$en" ]; then echo de
    elif [ "$en" -gt "$de" ]; then echo en
    else
        local locale_value="${VOICE_COMMANDS_LANG:-${LC_ALL:-${LC_MESSAGES:-${LANG:-}}}}"
        [ "${locale_value%%[_.@]*}" = de ] && echo de || echo en
    fi
}

play() {
    local file="$1" player
    for player in pw-play paplay aplay; do
        command -v "$player" >/dev/null && { "$player" "$file"; return; }
    done
}

# Splits the text into pieces of whole sentences of about 400 characters, one per line, so that reading
# starts after the first piece instead of after the whole text
pieces() {
    printf '%s\n' "$1" | sed -E 's/([.!?:;]) +/\1\n/g' | awk '
        length($0) == 0 { next }
        length(piece) > 0 && length(piece) + length($0) > 400 { print piece; piece = "" }
        { piece = length(piece) ? piece " " $0 : $0 }
        END { if (length(piece)) print piece }'
}

speak_piper() {
    local text="$1" language="$2" factor="$3" voice wav piece player="" number=0 options=()
    find_piper || return 1
    voice="$(piper_voice "$language")" || voice="$(piper_voice de)" || voice="$(piper_voice en)" || return 1
    SPEAK_DIR="$(mktemp -d "$RUN/speak.XXXXXX")"
    # Stopping ends the reader too: a trap that only removed the files let the system voice read the text again
    trap 'rm -rf "$SPEAK_DIR"' EXIT
    trap 'exit 0' TERM
    # The newer Piper writes --length-scale, the older one --length_scale
    case "$PIPER_HELP" in
        *--length-scale*) options=(--length-scale "$factor") ;;
        *--length_scale*) options=(--length_scale "$factor") ;;
    esac
    # Each piece is made while the one before it plays
    while IFS= read -r piece; do
        number=$((number + 1))
        wav="$SPEAK_DIR/$number.wav"
        if ! printf '%s\n' "$piece" | "$PIPER" -m "$voice" -f "$wav" "${options[@]}" >/dev/null 2>&1; then
            # Only the first piece falls back to the system voice; later the text is already half read
            [ "$number" = 1 ] && return 1
            break
        fi
        [ -z "$player" ] || wait "$player"
        play "$wav" &
        player=$!
    done < <(pieces "$text")
    [ -z "$player" ] || wait "$player"
    [ "$number" -gt 0 ]
}

speak_system() {
    local text="$1" language="$2" rate="$3" limit
    # A limit in case the voice hangs, long enough for long texts such as the help (about 15 characters a second)
    limit=$(( 300 + ${#text} / 10 ))
    case "$(system_voice)" in
        spd-say) timeout "$limit" spd-say --wait -l "$language" -r "$rate" -- "$text" ;;
        espeak-ng) timeout "$limit" espeak-ng -v "$language" -s $(( 175 + rate * 175 / 100 )) -- "$text" ;;
    esac
}

case "${1:-normal}" in
    stop) stop; exit ;;
    engine) engine; exit 0 ;;
    piper) find_piper && echo "$PIPER"; exit ;;
    __read)
        # Internal: the actual reading, in its own process group so that "stop" also ends the player. It
        # looks for a voice itself, which can take seconds, so that stopping works meanwhile too.
        echo $$ >"$PID_FILE"
        language="$2" factor="$3" rate="$4" text="$5"
        if ! speak_piper "$text" "$language" "$factor"; then
            speak_system "$text" "$language" "$rate"
        fi
        [ "$(cat "$PID_FILE" 2>/dev/null)" != $$ ] || rm -f "$PID_FILE"
        exit 0 ;;
    slow) factor=1.25; rate=-30 ;;
    fast) factor=0.8; rate=30 ;;
    *) factor=1.0; rate=0 ;;
esac

text="$(cat)"
[ -n "${text//[[:space:]]/}" ] || exit 0
stop
setsid "$0" __read "$(language_of "$text")" "$factor" "$rate" "$text" </dev/null >/dev/null 2>&1 &
# Noted at once, so that a stop right after this finds the reader; the reader notes itself again
echo $! >"$PID_FILE"
