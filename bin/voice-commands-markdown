#!/usr/bin/python3 -I
"""Turns Claude's Markdown replies into Pango markup for the response window or plain text for notifications.

Command line: voice-commands-markdown notify <length> [--escape] reads Markdown from stdin and prints
plain text of at most <length> characters. --escape escapes it for notification servers with body markup.
"""
import re
import sys
from html import escape as html_escape

CODE_SPAN = re.compile(r"(`+)(.+?)\1")
LINK = re.compile(r"\[([^\]]+)\]\((https?://[^)\s]+)\)")
BARE_URL = re.compile(r"(?<![\w/])https?://[^\s<>()\[\]]+[^\s<>()\[\].,;:!?\"'“”„]")
BOLD = re.compile(r"\*\*(?=\S)(.+?)(?<=\S)\*\*|(?<!\w)__(?=\S)(.+?)(?<=\S)__(?!\w)")
ITALIC = re.compile(r"(?<![\w*])\*(?=[^\s*])(.+?)(?<=[^\s*])\*(?![\w*])|(?<![\w_])_(?=[^\s_])(.+?)(?<=[^\s_])_(?![\w_])")
STRIKE = re.compile(r"~~(?=\S)(.+?)(?<=\S)~~")
HEADING = re.compile(r"^\s{0,3}(#{1,6})\s+(.*?)\s*#*\s*$")
RULE = re.compile(r"^\s{0,3}([-*_])(\s*\1){2,}\s*$")
LIST_ITEM = re.compile(r"^(\s*)([-*+]|\d{1,9}[.)])\s+(.*)$")
TASK = re.compile(r"^\[([ xX])\]\s+(.*)$")
QUOTE = re.compile(r"^\s{0,3}>\s?(.*)$")
FENCE = re.compile(r"^\s{0,3}(```|~~~)")
TABLE_ROW = re.compile(r"^\s*\|.*\|\s*$")
TABLE_SEPARATOR = re.compile(r"^\s*\|?\s*:?-{2,}:?\s*(\|\s*:?-{2,}:?\s*)*\|?\s*$")


def escape(text):
    return html_escape(text, quote=False)


def attr(text):
    return html_escape(text, quote=True)


def inline(text, pango):
    """Inline Markdown of one line, as Pango markup or as plain text."""
    original = text
    tokens = []

    def keep(value):
        tokens.append(value)
        return f"\x00{len(tokens) - 1}\x00"

    def code(match):
        content = match.group(2).strip()
        return keep(f"<tt>{escape(content)}</tt>" if pango else content)

    def link(match):
        label, url = match.group(1), match.group(2)
        if pango:
            return keep(f'<a href="{attr(url)}">{escape(label)}</a>')
        return keep(label)

    def bare(match):
        url = match.group(0)
        return keep(f'<a href="{attr(url)}">{escape(url)}</a>' if pango else url)

    text = CODE_SPAN.sub(code, text)
    text = LINK.sub(link, text)
    text = BARE_URL.sub(bare, text)
    if pango:
        text = escape(text)
    text = BOLD.sub(lambda m: f"<b>{m.group(1) or m.group(2)}</b>" if pango else (m.group(1) or m.group(2)), text)
    text = ITALIC.sub(lambda m: f"<i>{m.group(1) or m.group(2)}</i>" if pango else (m.group(1) or m.group(2)), text)
    text = STRIKE.sub(lambda m: f"<s>{m.group(1)}</s>" if pango else m.group(1), text)
    result = re.sub(r"\x00(\d+)\x00", lambda m: tokens[int(m.group(1))], text)
    # Overlapping marks like **a *b** c* give broken markup: show such a line as plain text
    if pango and not valid(result):
        return escape(inline(original, False))
    return result


def cells(row):
    row = row.strip()
    if row.startswith("|"):
        row = row[1:]
    if row.endswith("|"):
        row = row[:-1]
    return [cell.strip() for cell in row.split("|")]


def table(rows, pango):
    data = [[inline(cell, False) for cell in cells(row)] for row in rows if not TABLE_SEPARATOR.match(row)]
    has_header = len(rows) > 1 and TABLE_SEPARATOR.match(rows[1])
    if not pango:
        return [" · ".join(cell for cell in row if cell) for row in data]
    columns = max(len(row) for row in data)
    widths = [max((len(row[i]) if i < len(row) else 0) for row in data) for i in range(columns)]
    lines = []
    for number, row in enumerate(data):
        padded = [(row[i] if i < len(row) else "").ljust(widths[i]) for i in range(columns)]
        line = escape("  │  ".join(padded).rstrip())
        if number == 0 and has_header:
            line = f"<b>{line}</b>"
        lines.append(f'<span font_family="monospace">{line}</span>')
        if number == 0 and has_header:
            rule = "──┼──".join("─" * w for w in widths)
            lines.append(f'<span font_family="monospace" fgalpha="50%">{rule}</span>')
    return lines


def convert(markdown, pango):
    lines = markdown.replace("\r\n", "\n").split("\n")
    out = []
    i = 0
    while i < len(lines):
        line = lines[i]
        fence = FENCE.match(line)
        if fence:
            block = []
            i += 1
            while i < len(lines) and not lines[i].lstrip().startswith(fence.group(1)):
                block.append(lines[i])
                i += 1
            i += 1
            if pango:
                content = escape("\n".join(block))
                out.append(f'<span font_family="monospace" background="#808080" bgalpha="18%">{content}</span>')
            else:
                out.extend(block)
            continue
        if TABLE_ROW.match(line):
            rows = []
            while i < len(lines) and TABLE_ROW.match(lines[i]):
                rows.append(lines[i])
                i += 1
            out.extend(table(rows, pango))
            continue
        i += 1
        heading = HEADING.match(line)
        if heading:
            text = inline(heading.group(2), pango)
            if pango:
                size = {1: "x-large", 2: "large"}.get(len(heading.group(1)), "medium")
                text = f'<span weight="bold" size="{size}">{text}</span>'
            out.append(text)
            continue
        if RULE.match(line):
            out.append('<span fgalpha="40%">────────────────────</span>' if pango else "")
            continue
        item = LIST_ITEM.match(line)
        if item:
            level = len(item.group(1).expandtabs(4)) // 2
            marker = item.group(2)
            content = item.group(3)
            task = TASK.match(content)
            if task:
                marker, content = ("☑" if task.group(1) in "xX" else "☐"), task.group(2)
            elif not marker[0].isdigit():
                marker = "•◦▪"[min(level, 2)]
            out.append("    " * level + f"{marker} " + inline(content, pango))
            continue
        quote = QUOTE.match(line)
        if quote:
            text = inline(quote.group(1), pango)
            out.append(f'<span fgalpha="70%">▎ <i>{text}</i></span>' if pango else f"│ {text}")
            continue
        out.append(inline(line.strip(), pango))
    text = "\n".join(out)
    return re.sub(r"\n{3,}", "\n\n", text).strip()


def valid(markup):
    """True if a Gtk.Label accepts the markup. Links are a Gtk addition that Pango itself does not know."""
    import gi
    gi.require_version("Pango", "1.0")
    from gi.repository import Pango
    try:
        Pango.parse_markup(re.sub(r"<a href=\"[^\"]*\">", "<span>", markup).replace("</a>", "</span>"), -1, "\0")
    except Exception:
        return False
    return True


def to_pango(markdown):
    """Pango markup for a Gtk.Label, or None if Pango is not available or the result is not valid."""
    try:
        markup = convert(markdown, True)
        return markup if valid(markup) else None
    except (ImportError, ValueError):
        return None


def to_plain(markdown):
    return convert(markdown, False)


def to_speech(markdown, first_paragraph=False):
    """Text for reading aloud: without code blocks, web addresses and list marks."""
    kept, in_code = [], False
    for line in markdown.replace("\r\n", "\n").split("\n"):
        if FENCE.match(line):
            in_code = not in_code
            continue
        if not in_code:
            kept.append(line)
    text = BARE_URL.sub("", LINK.sub(lambda m: m.group(1), "\n".join(kept)))
    lines = []
    for line in to_plain(text).split("\n"):
        line = re.sub(r"^\s*([•◦▪☐☑│]\s*)", "", line).replace(" · ", ", ").strip()
        if first_paragraph and not line and lines:
            break
        if line and not RULE.match(line):
            # A line without final punctuation gets a pause, like a heading or list item
            lines.append(line if line[-1] in ".!?:;," else line + ".")
    return re.sub(r"\s+([.,;:!?])", r"\1", " ".join(lines))


def main():
    if len(sys.argv) >= 2 and sys.argv[1] == "speech":
        sys.stdout.write(to_speech(sys.stdin.read(), "first" in sys.argv[2:]))
        return
    if len(sys.argv) < 3 or sys.argv[1] != "notify":
        print(__doc__.strip(), file=sys.stderr)
        sys.exit(2)
    limit = int(sys.argv[2])
    text = to_plain(sys.stdin.read())
    if len(text) > limit:
        text = text[: limit - 1].rstrip() + "…"
    if "--escape" in sys.argv[3:]:
        text = escape(text)
    sys.stdout.write(text)


if __name__ == "__main__":
    main()
